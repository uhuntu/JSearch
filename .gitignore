# Visual J++ / Visual Studio per-user state.
# Binary, machine-specific, changes on every open. The original 2000 author
# already ignored these (see versions/2000-08/.gitignore).
*.suo

# MS Visual SourceSafe integration leftovers.
vssver.scc

# Local scratch and build output.
*.class.orig

# modern/ build output
modern/out/
modern/target/

# Kilo IDE workspace (auto-created, safe to delete)
.kilo/

# runner/ build output (tracked sources + engine table live beside it)
runner/classes/

# runner/ evidence-trail log, written by the CI job and by anyone reproducing
# it locally with `./run.sh --go > runner-ci.log`
runner-ci.log
