# EditorConfig helps maintain consistent coding styles
# across different editors and IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.java]
indent_size = 4

[*.{ps1,sh}]
indent_size = 2

[*.yml]
indent_size = 2

[*.json]
indent_size = 2
